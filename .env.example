# Chave da API da OpenAI, usada pelo assistente de chat em /api/chat
OPENAI_API_KEY=

# URL de conexão do Redis, usada para persistência de leads, conversas e rate limit
REDIS_URL=

# URL da API REST do Vercel KV (legado), checada como alternativa ao Redis em /api/contact
KV_REST_API_URL=

# Número de WhatsApp exibido publicamente nos links de contato (formato internacional, só dígitos)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Chave da API do Resend, usada para enviar e-mail de notificação de novo lead
RESEND_API_KEY=

# E-mail de destino que recebe a notificação de novo lead via Resend
LEAD_NOTIFY_EMAIL=

# URL de webhook (ex.: n8n/Make) que recebe o JSON do lead para notificação via WhatsApp/Telegram
LEAD_NOTIFY_WEBHOOK=
